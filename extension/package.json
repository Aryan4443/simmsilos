{
  "name": "simmsilos",
  "displayName": "SimmSilos",
  "description": "Branch assignment, task tracking and silo file access for SimmSilos",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aryan4443/simmsilos.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "simmsilos.login",          "title": "SimmSilos: Login" },
      { "command": "simmsilos.logout",         "title": "SimmSilos: Logout" },
      { "command": "simmsilos.refresh",        "title": "SimmSilos: Refresh" },
      { "command": "simmsilos.syncSilo",       "title": "SimmSilos: Sync Silo from Project" },
      { "command": "simmsilos.markDone",       "title": "Mark as Done" },
      { "command": "simmsilos.markInProgress", "title": "Mark as In Progress" },
      { "command": "simmsilos.viewTask",       "title": "View Task Details" },
      { "command": "simmsilos.switchBranch",   "title": "SimmSilos: Switch Branch" },
      { "command": "simmsilos.diffSilo",       "title": "Diff vs Project Master" }
    ],
    "menus": {
      "view/item/context": [
        { "command": "simmsilos.markInProgress", "when": "view == simmsilos.tasks && viewItem == task", "group": "1_status" },
        { "command": "simmsilos.markDone",       "when": "view == simmsilos.tasks && viewItem == task", "group": "1_status" },
        { "command": "simmsilos.viewTask",       "when": "view == simmsilos.tasks && viewItem == task", "group": "2_details" },
        { "command": "simmsilos.diffSilo",       "when": "view == simmsilos.files && viewItem == file", "group": "1_silo" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "simmsilos", "title": "SimmSilos", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "simmsilos": [
        { "id": "simmsilos.tasks", "name": "My Tasks" },
        { "id": "simmsilos.files", "name": "Silo Files" }
      ]
    },
    "configuration": {
      "title": "SimmSilos",
      "properties": {
        "simmsilos.apiUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "SimmSilos API base URL"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
